#!/usr/bin/env bash
set -euo pipefail

# Resolves Replicated app metadata from REPLICATED_APP and REPLICATED_CHANNEL
# env vars. Outputs JSON to stdout:
#   {"app_name": "...", "app_id": "...", "channel_id": "..."}

if [ -z "${REPLICATED_APP:-}" ]; then
  echo "Error: REPLICATED_APP environment variable is not set." >&2
  exit 1
fi

if [ -z "${REPLICATED_CHANNEL:-}" ]; then
  echo "Error: REPLICATED_CHANNEL environment variable is not set." >&2
  exit 1
fi

apps=$(replicated app ls --output json)

app_match=$(echo "$apps" | jq --arg app "$REPLICATED_APP" \
  '[.[] | select(.app.slug == $app)] | first // empty')

if [ -z "$app_match" ]; then
  echo "Error: App '${REPLICATED_APP}' not found." >&2
  exit 1
fi

channel_id=$(echo "$app_match" | jq -r --arg channel "$REPLICATED_CHANNEL" \
  '.channels[] | select(.channelSlug == $channel) | .id')

if [ -z "$channel_id" ]; then
  echo "Error: Channel '${REPLICATED_CHANNEL}' not found for app '${REPLICATED_APP}'." >&2
  exit 1
fi

echo "$app_match" | jq --arg channel_id "$channel_id" '{
  app_name: .app.name,
  app_id: .app.id,
  channel_id: $channel_id
}'
