#!/usr/bin/env bash
usage() {
    echo "Usage: $0 -o ORG_ALIAS -s SECRET"
    echo ""
    echo "Creates or updates the Replicated_Webhook_Secret__mdt record used"
    echo "by the webhook receiver for HMAC signature verification."
    exit 1
}

while getopts ":o:s:" opt; do
  case $opt in
    o)
      ORG_ALIAS=$OPTARG
      ;;
    s)
      SECRET=$OPTARG
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      usage
      ;;
    :)
      echo "Option -$OPTARG requires an argument." >&2
      usage
      ;;
  esac
done

if [ -z "$ORG_ALIAS" ]; then
    echo "Error: Org alias is required."
    usage
fi

if [ -z "$SECRET" ]; then
    echo "Error: Webhook secret is required."
    usage
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CMDT_DIR="$PROJECT_DIR/create-license/main/default/customMetadata"

mkdir -p "$CMDT_DIR"

sf cmdt generate record \
    --type-name Replicated_Webhook_Secret__mdt \
    --record-name Default \
    --label Default \
    --output-directory "$CMDT_DIR" \
    --input-directory "$PROJECT_DIR/create-license/main/default/objects" \
    "Secret__c=$SECRET"

sf project deploy start \
    --source-dir "$CMDT_DIR/Replicated_Webhook_Secret.Default.md-meta.xml" \
    --target-org "$ORG_ALIAS"
