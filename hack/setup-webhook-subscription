#!/usr/bin/env bash
set -euo pipefail

# Creates a Replicated event notification subscription for Salesforce CRM
# sync, or prints the existing subscription ID if one already exists.

: "${REPLICATED_SITE_URL:?REPLICATED_SITE_URL is not set}"
: "${REPLICATED_WEBHOOK_SECRET:?REPLICATED_WEBHOOK_SECRET is not set}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SUBSCRIPTION_NAME="Salesforce CRM Sync"
WEBHOOK_PATH="/services/apexrest/replicated/webhook"

# Resolve app metadata for event filters.
app_metadata=$("$SCRIPT_DIR/resolve-app-metadata")
app_id=$(echo "$app_metadata" | jq -r '.app_id')
app_name=$(echo "$app_metadata" | jq -r '.app_name')

echo "Checking for existing webhook subscription..."
existing=$(replicated api get /v3/notification_subscriptions | \
  jq -e --arg name "$SUBSCRIPTION_NAME" \
    '.subscriptions // [] | map(select(.name == $name)) | first // empty' 2>/dev/null) || true

if [ -n "$existing" ]; then
    id=$(echo "$existing" | jq -r '.id')
    echo "Subscription \"${SUBSCRIPTION_NAME}\" already exists (id: ${id}), skipping creation."
    exit 0
fi

# Strip trailing slash from site URL before appending the Apex REST path.
webhook_url="${REPLICATED_SITE_URL%/}${WEBHOOK_PATH}"

echo "Creating webhook subscription..."
echo "  Webhook URL: ${webhook_url}"
echo "  App filter:  ${app_name} (${app_id})"

body=$(jq -n \
  --arg url "$webhook_url" \
  --arg secret "$REPLICATED_WEBHOOK_SECRET" \
  --arg name "$SUBSCRIPTION_NAME" \
  --arg appId "$app_id" \
  --arg appName "$app_name" \
  '{
    name: $name,
    eventConfigs: [
      { eventType: "customer.created",           filters: { appId: $appId, appName: $appName } },
      { eventType: "customer.updated",           filters: { appId: $appId, appName: $appName } },
      { eventType: "customer.license_expiring",  filters: { appId: $appId, appName: $appName } },
      { eventType: "customer.ep_user_joined",    filters: { appId: $appId, appName: $appName } },
      { eventType: "customer.pending_signup",    filters: { appId: $appId, appName: $appName } },
      { eventType: "release.asset_downloaded",   filters: { appId: $appId, appName: $appName } },
      { eventType: "instance.created",           filters: { appId: $appId, appName: $appName } },
      { eventType: "instance.upgrade_completed", filters: { appId: $appId, appName: $appName } },
      { eventType: "instance.inactive",          filters: { appId: $appId, appName: $appName } }
    ],
    isEnabled: true,
    webhookUrl: $url,
    webhookSecret: $secret
  }')

result=$(replicated api post /v3/notification_subscription -b "$body")
id=$(echo "$result" | jq -r '.id')
echo "Created subscription \"${SUBSCRIPTION_NAME}\" (id: ${id})."
