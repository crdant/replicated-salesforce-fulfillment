#!/usr/bin/env bash
set -euo pipefail

# Removes Replicated webhook subscriptions named "Salesforce CRM Sync".
# Uses curl for DELETE since the replicated CLI lacks a delete subcommand.

: "${REPLICATED_SERVICE_ACCOUNT_TOKEN:?REPLICATED_SERVICE_ACCOUNT_TOKEN is not set}"

SUBSCRIPTION_NAME="Salesforce CRM Sync"
API_BASE="https://api.replicated.com/vendor"

echo "Checking for webhook subscriptions to remove..."
response=$(replicated api get /v3/notification_subscriptions)

ids=$(echo "$response" | jq -r --arg name "$SUBSCRIPTION_NAME" \
  '.subscriptions // [] | .[] | select(.name == $name) | .id')

if [ -z "$ids" ]; then
    echo "No subscription named \"${SUBSCRIPTION_NAME}\" found."
    exit 0
fi

echo "$ids" | while read -r id; do
    echo "Deleting subscription ${id}..."
    curl -s -X DELETE "${API_BASE}/v3/notification_subscription/${id}" \
      -H "Authorization: ${REPLICATED_SERVICE_ACCOUNT_TOKEN}" \
      -H "Content-Type: application/json"
done

echo "Done."
